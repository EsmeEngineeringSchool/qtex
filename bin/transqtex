#!/usr/bin/env python3
import argparse
import html
import os
import sys

from qtex.common.format_qtex import entrees
from qtex.common.qtex_parser import tokenize, ParseError


def translate_text(target: str, text: str) -> str:
    """Traduit text vers la langue cible (code ISO 639-1) via Google Cloud Translate v2."""
    from google.cloud import translate_v2 as translate

    client = translate.Client()
    if isinstance(text, bytes):
        text = text.decode("utf-8")
    result = client.translate(text, target_language=target)
    return html.unescape(result["translatedText"])


def parsing():
    parser = argparse.ArgumentParser()
    parser.add_argument('-i', '--input', type=argparse.FileType('r'),
                        default=sys.stdin, help='input file (single file)', required=True)
    parser.add_argument('-o', '--output', nargs='?', type=argparse.FileType('w'),
                        default=sys.stdout, help='output file or stdout')
    args = parser.parse_args()
    path = os.path.dirname(args.input.name) + '/'
    return path, args.input, args.output


if __name__ == "__main__":
    _path, file, output = parsing()
    try:
        entries, _errors = tokenize(file.read(), strict=True)
    except ParseError as err:
        print(f"{file.name}:{err.line} : {err.message}", file=sys.stderr)
        sys.exit(1)

    for e in entries:                      # ordre du fichier conservé
        if entrees[e.key]["translation"] and e.value:
            text = translate_text("en", e.value)
        else:
            text = e.value
        if e.kind == "long":
            print(f"#{e.key}", file=output)
            print(text, file=output)
            print(f"#END {e.key}", file=output)
        else:
            print(f"#{e.key} {text}", file=output)
